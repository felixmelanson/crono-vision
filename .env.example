# Copy to .env and fill in. .env is gitignored.

CRONOMETER_EMAIL=you@example.com
CRONOMETER_PASSWORD=your-password

# Used for login AND for deciding what "today" means. Set this or your
# 9pm dinner logs itself to tomorrow when running on a UTC server.
CRONOMETER_TIMEZONE=America/Toronto

# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Leave unset. vision.py picks a fast Lite model by default; pinning a
# bigger "better" one here is a 5-9x latency regression for no gain in what
# it actually reports (see DEFAULT_MODEL in vision.py). Set it only to
# experiment.
# GEMINI_MODEL=

# Optional: latency traded for better portion estimates. Unset does NOT mean
# off — a thinking model thinks by default, which is why this app defaults to
# one that doesn't. Only meaningful alongside a GEMINI_MODEL that supports it.
# GEMINI_THINKING_BUDGET=

# When each meal window opens, for the clock half of meal bucketing. Each
# entry is a start time; the window runs until the next one, and the last
# wraps past midnight. Unset uses breakfast:04:00,lunch:10:30,dinner:15:00,
# snacks:21:00 — the 04:00 start is what stops a 1am plate filing itself
# under tomorrow's breakfast. A malformed value falls back to those defaults.
# CRONO_MEAL_WINDOWS=breakfast:07:00,lunch:12:00,dinner:18:00,snacks:22:00

# Shared secret the iOS Shortcut sends as: Authorization: Bearer <token>
CRONO_VISION_TOKEN=generate-a-long-random-string
